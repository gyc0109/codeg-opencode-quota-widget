#!/usr/bin/env python3
import glob, os, shutil
web = os.environ.get("CODEG_STATIC_DIR", "/usr/local/share/codeg/web")
master = "/usr/local/share/codeg-opencode-quota/opencode-quota.js"
tag = '<script src="/opencode-quota.js"></script>'
# 1. 母本回拷：升级覆盖 web 目录后恢复 js 本体
if os.path.isfile(master):
    dst = os.path.join(web, "opencode-quota.js")
    if (not os.path.isfile(dst)) or (open(master,'rb').read() != open(dst,'rb').read()):
        shutil.copy2(master, dst)
        print(f"opencode-quota-patch: restored {dst}")
# 2. html 注入（幂等）
count = 0
for path in glob.glob(os.path.join(web, "*.html")):
    try:
        s = open(path, encoding="utf-8", errors="surrogateescape").read()
    except OSError: continue
    if "/opencode-quota.js" in s:
        continue
    if "</head>" in s:
        s = s.replace("</head>", tag + "</head>", 1)
    elif "</body>" in s:
        s = s.replace("</body>", tag + "</body>", 1)
    else:
        continue
    tmp = path + ".quota.tmp"
    open(tmp, "w", encoding="utf-8", errors="surrogateescape").write(s)
    os.replace(tmp, path)
    count += 1
    print(f"opencode-quota-patch: injected {path}")
print(f"opencode-quota-patch: done, patched {count} files")
