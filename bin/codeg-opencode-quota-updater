#!/usr/bin/env python3
"""多账号版 opencode-go 额度抓取：循环拉每个账号的 /usage，合并写入 opencode-quota.json"""
import json, os, re, sys, time, urllib.request, urllib.error, pathlib

ACCOUNTS_FILE = "/root/.config/opencode/quota-accounts.json"
FALLBACK_CONFIG = "/root/.config/opencode/opencode.jsonc"
OUT = os.environ.get("CODEG_STATIC_DIR", "/usr/local/share/codeg/web") + "/opencode-quota.json"
URL = "https://opencode.ai/zen/go/v1/usage"
INTERVAL = int(os.environ.get("OPENCODE_QUOTA_INTERVAL", "60"))

def load_accounts():
    try:
        d = json.loads(pathlib.Path(ACCOUNTS_FILE).read_text())
        acc = [(x.get("name", f"账号{i+1}"), x.get("apiKey", "")) for i, x in enumerate(d) if x.get("apiKey")]
        if acc: return acc
    except FileNotFoundError:
        pass
    except Exception as e:
        print(f"opencode-quota: accounts file error: {e}", file=sys.stderr)
    # 回退：单 key
    try:
        t = pathlib.Path(FALLBACK_CONFIG).read_text()
        m = re.search(r'"apiKey"\s*:\s*"([^"]+)"', t)
        if m: return [("主号", m.group(1))]
    except Exception as e:
        print(f"opencode-quota: fallback config error: {e}", file=sys.stderr)
    return []

def fetch(key):
    req = urllib.request.Request(URL, headers={
        "Authorization": f"Bearer {key}",
        "Accept": "application/json",
        "User-Agent": "Mozilla/5.0",
    })
    with urllib.request.urlopen(req, timeout=15) as r:
        return json.loads(r.read().decode())

def once():
    acc = load_accounts()
    if not acc:
        print("opencode-quota: no accounts", file=sys.stderr)
        return False
    out = {"accounts": []}
    ok = fail = 0
    for name, key in acc:
        try:
            data = fetch(key)
            usage = data.get("usage", data)
            out["accounts"].append({"name": name, "usage": usage})
            ok += 1
        except Exception as e:
            out["accounts"].append({"name": name, "error": str(e)[:120]})
            fail += 1
            print(f"opencode-quota: [{name}] failed: {e}", file=sys.stderr)
    out["_fetchedAt"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    # 兼容：单账号时同时保留顶层 usage（老前端可用）
    if len(out["accounts"]) == 1 and "usage" in out["accounts"][0]:
        out["usage"] = out["accounts"][0]["usage"]
    tmp = OUT + ".tmp"
    pathlib.Path(tmp).write_text(json.dumps(out, ensure_ascii=False))
    os.replace(tmp, OUT)
    print(f"opencode-quota: ok={ok} fail={fail} accounts={len(acc)}", flush=True)
    return fail == 0 or ok > 0

if __name__ == "__main__":
    if "--once" in sys.argv:
        sys.exit(0 if once() else 1)
    while True:
        try: once()
        except Exception as e: print(f"opencode-quota: loop error: {e}", file=sys.stderr)
        time.sleep(INTERVAL)
