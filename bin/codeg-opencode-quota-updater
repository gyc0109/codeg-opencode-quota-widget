#!/usr/bin/env python3
"""多账号版 opencode-go 额度抓取：循环拉每个账号的 /usage，合并写入 opencode-quota.json

输出位置：data 目录（api 读取）+ web 静态根（存在时镜像，供前端同源 fetch）。
"""
import json
import os
import sys
import time
import urllib.request
import pathlib

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import _codeg_quota_common as common  # noqa: E402

HISTORY_KEEP = 1500  # 约 25 小时（60s 间隔）
HISTORY_CHECK_EVERY = 30  # 每 N 轮才做一次截尾检查（读全文件有成本）
URL = "https://opencode.ai/zen/go/v1/usage"
INTERVAL = common.safe_int("OPENCODE_QUOTA_INTERVAL", 60, minimum=5)


def fetch(key):
    req = urllib.request.Request(URL, headers={
        "Authorization": "Bearer " + key,
        "Accept": "application/json",
        "User-Agent": "Mozilla/5.0",
    })
    with urllib.request.urlopen(req, timeout=15) as r:
        return json.loads(r.read().decode())


def append_history(accounts, tick):
    """用量快照 append 到 jsonl，供前端画 24h 曲线；定期截尾。"""
    line = {"t": int(time.time()), "a": [
        {"n": a.get("name", "?"),
         "r": (a.get("usage") or {}).get("rolling", {}).get("percent"),
         "w": (a.get("usage") or {}).get("weekly", {}).get("percent"),
         "m": (a.get("usage") or {}).get("monthly", {}).get("percent")}
        for a in accounts]}
    for path in common.write_targets("opencode-quota-history.jsonl"):
        try:
            path.parent.mkdir(parents=True, exist_ok=True)
            with open(path, "a", encoding="utf-8") as f:
                f.write(json.dumps(line, ensure_ascii=False) + "\n")
            if tick % HISTORY_CHECK_EVERY != 0:
                continue
            with open(path, encoding="utf-8") as f:
                lines = f.readlines()
            if len(lines) > HISTORY_KEEP + 200:
                with open(path, "w", encoding="utf-8") as f:
                    f.writelines(lines[-HISTORY_KEEP:])
        except OSError as e:
            print("opencode-quota: history write failed (%s): %s" % (path, e), file=sys.stderr)


def once(tick=0):
    acc = common.load_accounts()
    if not acc:
        print("opencode-quota: no accounts", file=sys.stderr)
        return False
    out = {"accounts": []}
    ok = fail = 0
    for name, key in acc:
        try:
            data = fetch(key)
            usage = data.get("usage", data)
            out["accounts"].append({"name": name, "usage": usage})
            ok += 1
        except Exception as e:
            out["accounts"].append({"name": name, "error": str(e)[:120]})
            fail += 1
            print("opencode-quota: [%s] failed: %s" % (name, e), file=sys.stderr)
    out["_fetchedAt"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    # 兼容：单账号时同时保留顶层 usage（老前端可用）
    if len(out["accounts"]) == 1 and "usage" in out["accounts"][0]:
        out["usage"] = out["accounts"][0]["usage"]
    payload = json.dumps(out, ensure_ascii=False)
    for path in common.write_targets("opencode-quota.json"):
        try:
            common.atomic_write_text(path, payload)
        except OSError as e:
            print("opencode-quota: write failed (%s): %s" % (path, e), file=sys.stderr)
    append_history(out["accounts"], tick)
    print("opencode-quota: ok=%d fail=%d accounts=%d" % (ok, fail, len(acc)), flush=True)
    return fail == 0 or ok > 0


if __name__ == "__main__":
    if "--once" in sys.argv:
        sys.exit(0 if once() else 1)
    tick = 0
    while True:
        try:
            once(tick)
        except Exception as e:
            print("opencode-quota: loop error: %s" % e, file=sys.stderr)
        tick += 1
        time.sleep(INTERVAL)
