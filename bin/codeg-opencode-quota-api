#!/usr/bin/env python3
"""codeg-opencode-quota 管理接口（sidecar）.

- /api/accounts         账号增删（请求头 X-Codeg-Token 鉴权）
- /quota.json          额度数据（桌面壳跨源读取）
- /quota-history.jsonl 24h 历史

鉴权：配置了 CODEG_TOKEN 时全部接口要求 token；未配置时（macOS 桌面默认）只接受
本机/桌面壳来源（Origin 白名单），阻止任意网站跨源读写。完整 key 永不外泄，
账号列表只返回脱敏前缀。
"""
import json
import os
import pathlib
import re
import subprocess
import sys
import time
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse, parse_qs

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import _codeg_quota_common as common  # noqa: E402

USAGE_URL = "https://opencode.ai/zen/go/v1/usage"
PORT = common.safe_int("OPENCODE_QUOTA_API_PORT", 3081, minimum=1)
HOST = os.environ.get("OPENCODE_QUOTA_API_HOST", "127.0.0.1" if common.IS_MACOS else "0.0.0.0")
ENV_FILE = "/etc/codeg.env"
REFRESH_DEBOUNCE_S = 10


def load_token():
    tok = os.environ.get("CODEG_TOKEN", "").strip()
    if tok:
        return tok
    try:
        for line in open(ENV_FILE, encoding="utf-8", errors="ignore"):
            line = line.strip()
            if line.startswith("CODEG_TOKEN="):
                return line.split("=", 1)[1].strip()
    except OSError:
        pass
    return ""


CODEG_TOKEN = load_token()


def save_accounts(acc):
    common.save_accounts(acc)


def check_key(key):
    req = urllib.request.Request(USAGE_URL, headers={
        "Authorization": "Bearer " + key, "Accept": "application/json",
        "User-Agent": "Mozilla/5.0"})
    with urllib.request.urlopen(req, timeout=15) as r:
        d = json.loads(r.read().decode())
    u = d.get("usage", d)
    if not (u.get("rolling") and u.get("weekly") and u.get("monthly")):
        raise ValueError("unexpected usage response")
    return u


def trigger_refresh():
    """触发一次抓取；10 秒内已有触发则跳过（防连点/重试风暴）。"""
    stamp = common.data_dir() / ".last-refresh"
    try:
        if stamp.exists() and (time.time() - stamp.stat().st_mtime) < REFRESH_DEBOUNCE_S:
            return
        stamp.parent.mkdir(parents=True, exist_ok=True)
        stamp.touch()
    except OSError:
        pass
    updater = pathlib.Path(__file__).resolve().with_name("codeg-opencode-quota-updater")
    if not updater.is_file():
        updater = pathlib.Path("/usr/local/bin/codeg-opencode-quota-updater")
    try:
        subprocess.Popen([str(updater), "--once"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def local_file(name):
    """读取数据文件：按写入目标顺序找（data 目录优先）。"""
    for p in common.write_targets(name):
        try:
            if p.is_file():
                return p.read_bytes()
        except OSError:
            continue
    return None


class H(BaseHTTPRequestHandler):
    server_version = "quota-api/1.0"

    def log_message(self, fmt, *args):
        try:
            origin = self.headers.get("Origin", "-")
            sys.stderr.write("quota-api: [%s] %s\n" % (origin, fmt % args))
        except Exception:
            pass

    def _cors(self):
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Headers", "X-Codeg-Token, Content-Type")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, DELETE, OPTIONS")

    def _send(self, code, obj):
        body = json.dumps(obj, ensure_ascii=False).encode()
        self.send_response(code)
        self._cors()
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _send_raw(self, code, body, ctype):
        self.send_response(code)
        self._cors()
        self.send_header("Content-Type", ctype)
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _origin_ok(self):
        """未配置 token 时的来源白名单：无 Origin（curl/本机进程）、桌面壳、本机来源。"""
        origin = self.headers.get("Origin", "").strip()
        if not origin:
            return True
        if origin == "null":  # file:// / 部分自定义协议（WKWebView 可能如此）
            return True
        m = re.match(r"^([A-Za-z][A-Za-z0-9+.\-]*)://([^/]*)", origin)
        if not m:
            return False
        scheme, host = m.group(1).lower(), m.group(2).lower()
        if scheme in ("tauri", "file", "asset"):
            return True
        if host.startswith("["):
            host = host[: host.index("]") + 1]
        elif ":" in host:
            host = host.rsplit(":", 1)[0]
        return host in ("127.0.0.1", "localhost", "::1", "[::1]")

    def _authed(self):
        if CODEG_TOKEN:
            return self.headers.get("X-Codeg-Token", "") == CODEG_TOKEN
        return self._origin_ok()

    def do_OPTIONS(self):
        self.send_response(204)
        self._cors()
        self.end_headers()

    def do_GET(self):
        path = urlparse(self.path).path
        if not self._authed():
            return self._send(401, {"error": "unauthorized"})
        if path == "/quota.json":
            body = local_file("opencode-quota.json")
            if body is None:
                return self._send(404, {"error": "no quota data yet"})
            return self._send_raw(200, body, "application/json; charset=utf-8")
        if path == "/quota-history.jsonl":
            body = local_file("opencode-quota-history.jsonl") or b""
            return self._send_raw(200, body, "text/plain; charset=utf-8")
        if path != "/api/accounts":
            return self._send(404, {"error": "not found"})
        acc = common.load_accounts()
        self._send(200, {"accounts": [
            {"name": n, "keyPrefix": (k[:10] + "..." if len(k) > 13 else "***")}
            for n, k in acc]})

    def do_POST(self):
        if urlparse(self.path).path != "/api/accounts":
            return self._send(404, {"error": "not found"})
        if not self._authed():
            return self._send(401, {"error": "unauthorized"})
        try:
            n = int(self.headers.get("Content-Length", "0"))
            body = json.loads(self.rfile.read(n).decode() or "{}")
        except (ValueError, json.JSONDecodeError):
            return self._send(400, {"error": "bad json"})
        if not isinstance(body, dict):
            return self._send(400, {"error": "body must be a json object"})
        name = str(body.get("name") or "").strip()[:32]
        key = str(body.get("apiKey") or "").strip()
        if not name or not key:
            return self._send(400, {"error": "name and apiKey required"})
        if not re.fullmatch(r"sk-[A-Za-z0-9_-]{8,}", key):
            return self._send(400, {"error": "apiKey looks invalid (expect sk-...)"})
        try:
            usage = check_key(key)
        except Exception as e:
            return self._send(502, {"error": ("key validation failed: %s" % e)[:200]})
        acc = [(nn, kk) for nn, kk in common.load_accounts() if nn != name]
        acc.append((name, key))
        try:
            save_accounts(acc)
        except OSError as e:
            return self._send(500, {"error": "save failed: %s" % e})
        trigger_refresh()
        r = usage["rolling"]
        self._send(200, {"ok": True, "name": name,
                         "check": {"rolling": r.get("percent"), "resetsAt": r.get("resetsAt")}})

    def do_DELETE(self):
        if urlparse(self.path).path != "/api/accounts":
            return self._send(404, {"error": "not found"})
        if not self._authed():
            return self._send(401, {"error": "unauthorized"})
        name = parse_qs(urlparse(self.path).query).get("name", [""])[0].strip()
        if not name:
            return self._send(400, {"error": "name required"})
        acc = common.load_accounts()
        if not any(n == name for n, _ in acc):
            return self._send(404, {"error": "no such account"})
        save_accounts([(n, k) for n, k in acc if n != name])
        trigger_refresh()
        self._send(200, {"ok": True, "deleted": name})


if __name__ == "__main__":
    if not CODEG_TOKEN:
        print("quota-api: no CODEG_TOKEN, origin allowlist mode (localhost/desktop only)",
              file=sys.stderr)
    httpd = ThreadingHTTPServer((HOST, PORT), H)
    print("quota-api: listening on %s:%d" % (HOST, PORT), flush=True)
    httpd.serve_forever()
