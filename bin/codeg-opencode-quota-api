#!/usr/bin/env python3
"""codeg-opencode-quota 管理接口（sidecar，供前端读写 quota-accounts.json）.

监听 127.0.0.1:3081 + 对外端口（见 service 文件），鉴权：请求头 X-Codeg-Token
必须等于 /etc/codeg.env 里的 CODEG_TOKEN。完整 key 永不外泄，只返回脱敏前缀。
"""
import json, os, re, subprocess, sys, urllib.request
from http.server import BaseHTTPRequestHandler, HTTPServer
from urllib.parse import urlparse, parse_qs

ACCOUNTS_FILE = "/root/.config/opencode/quota-accounts.json"
ENV_FILE = "/etc/codeg.env"
USAGE_URL = "https://opencode.ai/zen/go/v1/usage"
PORT = int(os.environ.get("OPENCODE_QUOTA_API_PORT", "3081"))

def load_token():
    tok = os.environ.get("CODEG_TOKEN", "").strip()
    if tok: return tok
    try:
        for line in open(ENV_FILE, encoding="utf-8", errors="ignore"):
            line = line.strip()
            if line.startswith("CODEG_TOKEN="):
                return line.split("=", 1)[1].strip()
    except OSError:
        pass
    return ""

CODEG_TOKEN = load_token()

def load_accounts():
    try:
        d = json.load(open(ACCOUNTS_FILE, encoding="utf-8"))
        return [(x.get("name", "?"), x.get("apiKey", "")) for x in d if x.get("apiKey")]
    except (FileNotFoundError, json.JSONDecodeError, AttributeError):
        return []

def save_accounts(acc):
    tmp = ACCOUNTS_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump([{"name": n, "apiKey": k} for n, k in acc], f, ensure_ascii=False, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, ACCOUNTS_FILE)

def check_key(key):
    req = urllib.request.Request(USAGE_URL, headers={
        "Authorization": f"Bearer {key}", "Accept": "application/json",
        "User-Agent": "Mozilla/5.0"})
    with urllib.request.urlopen(req, timeout=15) as r:
        d = json.loads(r.read().decode())
    u = d.get("usage", d)
    if not (u.get("rolling") and u.get("weekly") and u.get("monthly")):
        raise ValueError("unexpected usage response")
    return u

def trigger_refresh():
    try:
        subprocess.Popen(["/usr/local/bin/codeg-opencode-quota-updater", "--once"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass

class H(BaseHTTPRequestHandler):
    server_version = "quota-api/1.0"

    def log_message(self, *a):
        sys.stderr.write("quota-api: %s %s\n" % (a[0], a[1]))

    def _cors(self):
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Headers", "X-Codeg-Token, Content-Type")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, DELETE, OPTIONS")

    def _send(self, code, obj):
        body = json.dumps(obj, ensure_ascii=False).encode()
        self.send_response(code)
        self._cors()
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _authed(self):
        if not CODEG_TOKEN:
            return True  # 未配置 token 时放行（本机可信环境兜底）
        got = self.headers.get("X-Codeg-Token", "")
        if not got:
            got = parse_qs(urlparse(self.path).query).get("token", [""])[0]
        return got == CODEG_TOKEN

    def do_OPTIONS(self):
        self.send_response(204)
        self._cors()
        self.end_headers()

    def do_GET(self):
        if urlparse(self.path).path != "/api/accounts":
            return self._send(404, {"error": "not found"})
        if not self._authed():
            return self._send(401, {"error": "unauthorized"})
        acc = load_accounts()
        self._send(200, {"accounts": [
            {"name": n, "keyPrefix": (k[:10] + "..." if len(k) > 13 else "***")}
            for n, k in acc]})

    def do_POST(self):
        if urlparse(self.path).path != "/api/accounts":
            return self._send(404, {"error": "not found"})
        if not self._authed():
            return self._send(401, {"error": "unauthorized"})
        try:
            n = int(self.headers.get("Content-Length", "0"))
            body = json.loads(self.rfile.read(n).decode() or "{}")
        except (ValueError, json.JSONDecodeError):
            return self._send(400, {"error": "bad json"})
        name = (body.get("name") or "").strip()[:32]
        key = (body.get("apiKey") or "").strip()
        if not name or not key:
            return self._send(400, {"error": "name and apiKey required"})
        if not re.fullmatch(r"sk-[A-Za-z0-9_-]{8,}", key):
            return self._send(400, {"error": "apiKey looks invalid (expect sk-...)"})
        try:
            usage = check_key(key)
        except Exception as e:
            return self._send(502, {"error": f"key validation failed: {e}"[:200]})
        acc = [(nn, kk) for nn, kk in load_accounts() if nn != name]
        acc.append((name, key))
        try:
            save_accounts(acc)
        except OSError as e:
            return self._send(500, {"error": f"save failed: {e}"})
        trigger_refresh()
        r = usage["rolling"]
        self._send(200, {"ok": True, "name": name,
                         "check": {"rolling": r.get("percent"), "resetsAt": r.get("resetsAt")}})

    def do_DELETE(self):
        if urlparse(self.path).path != "/api/accounts":
            return self._send(404, {"error": "not found"})
        if not self._authed():
            return self._send(401, {"error": "unauthorized"})
        name = parse_qs(urlparse(self.path).query).get("name", [""])[0].strip()
        if not name:
            return self._send(400, {"error": "name required"})
        acc = load_accounts()
        if not any(n == name for n, _ in acc):
            return self._send(404, {"error": "no such account"})
        save_accounts([(n, k) for n, k in acc if n != name])
        trigger_refresh()
        self._send(200, {"ok": True, "deleted": name})

if __name__ == "__main__":
    if not CODEG_TOKEN:
        print("quota-api: WARNING no CODEG_TOKEN found, auth disabled", file=sys.stderr)
    httpd = HTTPServer(("0.0.0.0", PORT), H)
    print(f"quota-api: listening on :{PORT}", flush=True)
    httpd.serve_forever()
